# ReceptionAI — Environment Variables (example)
# Copy to `.env` and fill in real values. Never commit the real `.env`.

# ── Database (Neon serverless Postgres) ──────────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# ── Google Calendar sync (optional) ─────────────────────────────────────────
# Create a Google Cloud OAuth 2.0 Web client with redirect URI set to
# GOOGLE_REDIRECT_URI, then fill these in. Without them, /api/calendar/*
# returns a "not configured" JSON response and the UI hides the connect flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.receptionai.store/api/calendar/oauth/google/callback

# ── Encryption key for stored OAuth tokens (32 bytes; hex or base64) ────────
# Generate with: openssl rand -hex 32
APP_ENC_KEY=

# ── Payments ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Telephony / SMS ─────────────────────────────────────────────────────────
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
# ── Cron (reminder/follow-up processor) ─────────────────────────────────────
CRON_SECRET=
# ── Public host for outbound call webhooks (must be reachable by Telnyx) ────
HOST=
# ── AI / voice ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# ElevenLabs (optional, premium account required). Leave ELEVENLABS_API_KEY_REF
# empty to use the built-in per-language Amazon Polly neural voices
# (English: Polly.Joanna-Neural, Spanish: Polly.Lupe-Neural).
# ELEVENLABS_API_KEY_REF = the identifier of the ElevenLabs API key you stored
# in Telnyx secure storage (POST /v2/integration_secrets). See ELEVENLABS_SETUP.md.
ELEVENLABS_API_KEY_REF=
# ElevenLabs voice IDs (English + Spanish). Spanish falls back to the English
# voice when unset. Default: "21m00Tcm4TlvDq8ikWAM" (Rachel).
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_ES=
# ── Branding (fallback company name for the greeting) ───────────────────────
COMPANY_NAME=
